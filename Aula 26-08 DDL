-- FUNÇOES DE AGRUPAMENTO (SUM (SOMATORIO) AVG (AVERAGE) MAX (MAIOR VALOR) MIN (MENOR VALOR) COUNT (CONTADOR))

SELECT * FROM ITEMPEDIDO;

SELECT sum(preco_unitario) valor_unitario, sum(QUANTIDADE * PRECO_UNITARIO) TOTAL_VENDA
FROM ITEMPEDIDO;

SELECT * FROM ITEMPEDIDO
WHERE produto_id = 2 and pedido_id = 1;

UPDATE ITEMPEDIDO
SET quantidade = 5
WHERE produto_id = 2 and pedido_id = 1;

SELECT SUM(QUANTIDADE * PRECO_UNITARIO) TOTAL_VENDA,
	AVG(QUANTIDADE * PRECO_UNITARIO) MEDIA_VENDA,
	MAX(QUANTIDADE * PRECO_UNITARIO) MAIOR_VENDA,
	MIN(QUANTIDADE * PRECO_UNITARIO) MENOR_VENDA,
    COUNT(PRODUTO_ID)				 QTD_ITENS_VENDA
FROM ITEMPEDIDO;

SELECT PRODUTO_ID, SUM(PRECO_UNITARIO * QUANTIDADE) VALOR_TOTAL
FROM ITEMPEDIDO
GROUP BY PRODUTO_ID; -- NÃO É MAIS UM AGRUPAMENTO SIMPLES. AGORA, AGRUPA POR PRODUTO (TODAS AS COLUNAS COLOCADAS ANTES DA FUNCAO DE AGRUPAMENTO, PRECISAM SER COLOCADAS NO GROUP BY (PODE TER MAIS DE UMA)

SELECT PRODUTO_ID, PEDIDO_ID, SUM(PRECO_UNITARIO * QUANTIDADE) VALOR_TOTAL
FROM ITEMPEDIDO
WHERE PEDIDO_ID BETWEEN 1 AND 3
GROUP BY PRODUTO_ID, PEDIDO_ID;

SELECT PEDIDO_ID, SUM(PRECO_UNITARIO * QUANTIDADE) VALOR_TOTAL
FROM ITEMPEDIDO
GROUP BY PEDIDO_ID
HAVING VALOR_TOTAL > 2000 -- AGRUPA PARA FAZER A CONDICIONAL. NAO USA O WHERE MAIS DE 1X.
-- SE NAO ACEITAR == HAVING SUM (PRECO_UNITARIO * QUANTIDADE) > 2000;
ORDER BY VALOR_TOTAL DESC;







