-- SELECT COM OPERADORES DE COMPARAÇÃO
-- (= > >= < <= !=) <>

-- WHERE COLUNA CONDICAO VALOR
SELECT IDPRODUTO CODPRODUTO,
	nome	nomeproduto
from produto
where idproduto =1;

SELECT idproduto codproduto,
	nome	nomeproduto,
    preco_unitario valor_produto
from produto
where preco_unitario > 50.00;

-- OPERADORES CONDICIONAIS
-- AND, OR, NOT 

-- PRECO_UNITARIO MAIOR QUE 50 OU ESTOQUE MAIOR QUE 10 

SELECT * FROM PRODUTO
WHERE preco_unitario > 50 OR estoque > 10;

SELECT * FROM PRODUTO
WHERE estoque >= 10 and estoque <= 20;

SELECT * FROM PRODUTO
WHERE NOT (estoque BETWEEN 1 AND 20);
-- Pode usar (estoque between 10 and 20);

SELECT * FROM PRODUTO
WHERE CATEGORIA_ID =1 OR CATEGORIA_ID = 2;

SELECT *FROM PRODUTO
WHERE CATEGORIA_ID (1,2);

SELECT * FROM PRODUTO
WHERE CATEGORIA_ID NOT IN (1,2);

-- STRING (FUNÇÕES)
-- LIKE
-- INICIA  COM - STRING%
-- TERMINA COM - %STRING
-- CONTÉM 	   - %STRING% 	

SELECT * FROM PRODUTO
WHERE NOME LIKE 'S%';

SELECT * FROM PRODUTO
WHERE NOME LIKE '%a';

SELECT * FROM PRODUTO
WHERE NOME LIKE '%pre%';
